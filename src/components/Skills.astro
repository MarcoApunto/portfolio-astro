---
import { icons } from '../data/skill-icons';
import { skills } from '../data/skills';
---

<section class="py-20" id="skills">
  <div class="text-center mb-12">
    <h2
      class="text-3xl md:text-4xl font-bold text-text-light-primary dark:text-text-dark-primary"
    >
      Habilidades técnicas
    </h2>
    <div class="mt-2 h-1 w-20 bg-primary mx-auto"></div>
  </div>

  <div class="bg-surface-light/50 dark:bg-surface-dark/50 rounded-lg p-6">
    <div
      class="max-w-5xl mx-auto grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-6 items-center justify-center"
    >
      {skills.map(({ name, icon }) => (
        <div
          class="flex flex-col items-center p-4 bg-surface-light dark:bg-surface-dark rounded-lg shadow-md hover:shadow-primary/20 hover:shadow-lg transition-shadow duration-300"
        >
          <p class="font-semibold text-text-light-primary dark:text-text-dark-primary flex items-center gap-1">
            <span class="inline-flex items-center justify-center" set:html={icons[icon]}></span>
            {name}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
